{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "next/link": [
        "./landing/link.tsx"
      ]
    }
  },
  "include": [
    "studio/**/*.tsx",
    "app/**/*.tsx",
    "landing/**/*.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
