{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build:sdk": "tsc -b platform/packages/sdk platform/packages/familiar platform/packages/host platform/packages/esp32 && bun build platform/packages/host/src/browser.ts --target browser --outfile platform/packages/host/dist/preview-browser.js",
    "build": "bun run build:sdk && node landing/build.mjs && node studio/build.mjs",
    "dev": "bun runtime/cli.ts dev",
    "orbit": "bun runtime/cli.ts",
    "desktop:build": "bash desktop/scripts/build-app.sh",
    "desktop:open": "bash desktop/scripts/open-app.sh",
    "check": "tsc --noEmit && tsc -p runtime/tsconfig.json --noEmit",
    "test": "bun test platform/tests runtime/tests"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@orbit/familiar": "workspace:*",
    "@orbit/sdk": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.0",
    "tw-animate-css": "1.4.0",
    "@orbit/esp32": "workspace:*",
    "@orbit/host": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "@types/bun": "1.4.2"
  },
  "type": "module",
  "workspaces": [
    "platform/packages/*"
  ],
  "packageManager": "bun@1.4.0-canary.1",
  "description": "Give your AI a little presence. An open TypeScript runtime, simulator and desktop Familiar."
}
